<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>
</head>

<body style="
    margin:0;
    font-family:Arial;
    background:#eef2ff;
">

<!-- SIDEBAR -->

<div style="
    width:250px;
    height:100vh;
    background:#0f172a;
    position:fixed;
    left:0;
    top:0;
    padding-top:30px;
">

    <h1 style="
        color:white;
        text-align:center;
    ">
        Admin Panel
    </h1>

    <a href="/admin/dashboard" style="
        display:block;
        color:white;
        padding:18px;
        text-decoration:none;
    ">
        📊 Dashboard
    </a>

    <a href="/admin/upload" style="
        display:block;
        color:white;
        padding:18px;
        text-decoration:none;
    ">
        📘 Upload Questions
    </a>

    <a href="/admin/activities" style="
        display:block;
        color:white;
        padding:18px;
        text-decoration:none;
    ">
        👨‍🎓 Student Activities
    </a>

    <a href="/admin/results" style="
        display:block;
        color:white;
        padding:18px;
        text-decoration:none;
    ">
        🏆 Results
    </a>

</div>



<!-- MAIN CONTENT -->

<div style="
    margin-left:270px;
    padding:40px;
">

    <h1 style="
        color:#0f172a;
    ">
        Welcome Admin
    </h1>


    <!-- TOP CARDS -->

    <div style="
        display:flex;
        gap:25px;
        flex-wrap:wrap;
        margin-top:40px;
    ">

        <!-- CARD -->

        <div style="
            background:white;
            width:250px;
            padding:30px;
            border-radius:15px;
            box-shadow:0px 5px 15px rgba(0,0,0,0.1);
        ">

            <h2>Total Students</h2>

            <h1 style="color:#2563eb;">
                120
            </h1>

        </div>


        <div style="
            background:white;
            width:250px;
            padding:30px;
            border-radius:15px;
            box-shadow:0px 5px 15px rgba(0,0,0,0.1);
        ">

            <h2>Total Exams</h2>

            <h1 style="color:#16a34a;">
                15
            </h1>

        </div>


        <div style="
            background:white;
            width:250px;
            padding:30px;
            border-radius:15px;
            box-shadow:0px 5px 15px rgba(0,0,0,0.1);
        ">

            <h2>Active Exams</h2>

            <h1 style="color:#dc2626;">
                3
            </h1>

        </div>

    </div>

</div>

</body>
</html>