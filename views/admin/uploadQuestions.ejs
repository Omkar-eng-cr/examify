<!DOCTYPE html>
<html>

<head>
    <title>Upload Questions</title>
</head>

<body style="
    margin:0;
    font-family:Arial;
    background:#eef2ff;
">

<div style="
    width:60%;
    margin:auto;
    margin-top:60px;
    background:white;
    padding:40px;
    border-radius:20px;
">

    <h1 style="
        text-align:center;
        color:#2563eb;
    ">
        Upload MCQ Question
    </h1>

    <form>

        <input
            type="text"
            placeholder="Enter Question"

            style="
                width:100%;
                padding:15px;
                margin-bottom:20px;
            "
        >

        <input
            type="text"
            placeholder="Option 1"

            style="
                width:100%;
                padding:15px;
                margin-bottom:20px;
            "
        >

        <input
            type="text"
            placeholder="Option 2"

            style="
                width:100%;
                padding:15px;
                margin-bottom:20px;
            "
        >

        <input
            type="text"
            placeholder="Option 3"

            style="
                width:100%;
                padding:15px;
                margin-bottom:20px;
            "
        >

        <input
            type="text"
            placeholder="Option 4"

            style="
                width:100%;
                padding:15px;
                margin-bottom:20px;
            "
        >

        <input
            type="text"
            placeholder="Correct Answer"

            style="
                width:100%;
                padding:15px;
                margin-bottom:25px;
            "
        >

        <button style="
            width:100%;
            background:#2563eb;
            color:white;
            border:none;
            padding:18px;
            border-radius:10px;
            font-size:18px;
            cursor:pointer;
        ">

            Upload Question

        </button>

    </form>

</div>

</body>
</html>