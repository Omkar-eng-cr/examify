<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MCQ Exam - Examify</title>

</head>

<body style="
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
    background:#eef2ff;
">

<!-- NAVBAR -->

<div style="
    width:100%;
    background:#0f172a;
    padding:18px 0;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0px 2px 10px rgba(0,0,0,0.2);
">

    <div style="
        width:92%;
        margin:auto;
        display:flex;
        justify-content:space-between;
        align-items:center;
        flex-wrap:wrap;
    ">

        <!-- LOGO -->

        <h2 style="
            color:white;
            margin:0;
            font-size:30px;
        ">
            Examify
        </h2>


        <!-- RIGHT SIDE -->

        <div style="
            display:flex;
            align-items:center;
            gap:20px;
        ">

            <!-- TIMER -->

            <div style="
                background:#dc2626;
                color:white;
                padding:10px 20px;
                border-radius:10px;
                font-size:18px;
                font-weight:bold;
                box-shadow:0px 5px 15px rgba(220,38,38,0.3);
            ">

                ⏰
                <span id="timer">
                    30:00
                </span>

            </div>


            <!-- SMALL CAMERA -->

            <div style="
                background:white;
                padding:8px;
                border-radius:12px;
                box-shadow:0px 3px 10px rgba(0,0,0,0.2);
                text-align:center;
            ">

                <video
                    id="video"
                    autoplay
                    muted

                    style="
                        width:120px;
                        height:80px;
                        border-radius:10px;
                        object-fit:cover;
                        background:black;
                        border:2px solid #2563eb;
                    "
                ></video>

                <div style="
                    margin-top:5px;
                    color:#16a34a;
                    font-size:12px;
                    font-weight:bold;
                ">
                    ● Camera Active
                </div>

            </div>

        </div>

    </div>

</div>


<!-- MAIN CONTAINER -->

<div style="
    width:85%;
    margin:auto;
    margin-top:40px;
">

    <!-- TITLE -->

    <div style="
        background:white;
        padding:35px;
        border-radius:20px;
        box-shadow:0px 5px 15px rgba(0,0,0,0.08);
        margin-bottom:40px;
        text-align:center;
    ">

        <h1 style="
            color:#0f172a;
            margin:0;
            font-size:45px;
        ">
            Online MCQ Examination
        </h1>

        <p style="
            color:gray;
            font-size:18px;
            margin-top:15px;
        ">
            Complete all questions before time ends
        </p>

    </div>


    <!-- QUESTIONS FORM -->

    <form action="/result" method="POST" id="examForm">

        <% questions.forEach((q, index) => { %>

            <div style="
                background:white;
                padding:35px;
                border-radius:20px;
                margin-bottom:30px;
                box-shadow:0px 5px 15px rgba(0,0,0,0.08);
            ">

                <!-- QUESTION -->

                <h2 style="
                    color:#0f172a;
                    margin-bottom:25px;
                    line-height:35px;
                ">

                    Q<%= index + 1 %>.
                    <%= q.question %>

                </h2>


                <!-- OPTIONS -->

                <% q.options.forEach(option => { %>

                    <label style="
                        display:block;
                        background:#f8fafc;
                        padding:18px;
                        margin-bottom:15px;
                        border-radius:10px;
                        cursor:pointer;
                        border:1px solid #d1d5db;
                        font-size:17px;
                        transition:0.3s;
                    ">

                        <input
                            type="radio"
                            name="q<%= index %>"
                            value="<%= option %>"
                            required

                            style="
                                margin-right:12px;
                                transform:scale(1.3);
                            "
                        >

                        <%= option %>

                    </label>

                <% }) %>

            </div>

        <% }) %>


        <!-- SUBMIT BUTTON -->

        <div style="
            text-align:center;
            margin-bottom:50px;
        ">

            <button style="
                background:#2563eb;
                color:white;
                border:none;
                padding:18px 45px;
                border-radius:10px;
                cursor:pointer;
                font-size:20px;
                font-weight:bold;
                box-shadow:0px 5px 15px rgba(37,99,235,0.3);
            ">

                Submit Exam

            </button>

        </div>

    </form>

</div>


<!-- FOOTER -->

<div style="
    width:100%;
    background:#0f172a;
    padding:20px 0;
">

    <h3 style="
        color:white;
        text-align:center;
        margin:0;
        font-weight:normal;
    ">
        © 2026 Examify | Secure Online Examination System
    </h3>

</div>



<!-- TIMER SCRIPT -->

<script>

let timeLeft = 1800;

const timer = document.getElementById("timer");

const countdown = setInterval(() => {

    let minutes = Math.floor(timeLeft / 60);
    let seconds = timeLeft % 60;

    minutes = minutes < 10 ? "0" + minutes : minutes;
    seconds = seconds < 10 ? "0" + seconds : seconds;

    timer.innerHTML = minutes + ":" + seconds;

    timeLeft--;

    if (timeLeft < 0) {

        clearInterval(countdown);

        alert("Time is over! Exam will auto submit.");

        document.getElementById("examForm").submit();

    }

}, 1000);

</script>



<!-- CAMERA SCRIPT -->

<script>

const video = document.getElementById("video");

navigator.mediaDevices.getUserMedia({
    video: true
})

.then((stream) => {

    video.srcObject = stream;

})

.catch((error) => {

    alert("Camera access denied!");

});

</script>



<!-- ANTI CHEAT -->

<script>

document.addEventListener("visibilitychange", () => {

    if(document.hidden){

        alert("Tab switching detected! Please stay on exam screen.");

    }

});


// Disable Right Click

document.addEventListener("contextmenu", (e) => {

    e.preventDefault();

});


// Disable Copy

document.addEventListener("copy", (e) => {

    e.preventDefault();

});

</script>

</body>
</html>